{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/smart-approve.py" },
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/block-dev-server.js" },
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-push-check.js" },
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/commit-guard.js" }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/block-md-creation.js" },
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/secret-scanner.js" }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/secret-scanner.js" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/post-edit-check.js" },
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/lint-fix.js" },
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/type-check.js" },
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/auto-test.js" },
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/bundle-check.js" }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/post-edit-check.js" },
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/lint-fix.js" },
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/type-check.js" },
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/auto-test.js" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/suggest-compact.js" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-start.js" },
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/context-loader.js" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-end.js" },
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/learning-log.js" }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-compact.js" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/stop-check.js" }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/notification-log.js" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/prompt-check.js" }
        ]
      }
    ]
  }
}
